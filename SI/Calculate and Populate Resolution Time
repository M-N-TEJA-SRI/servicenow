KAP_SI_3.prototype = {
    initialize: function() {
    },
getduration: function(res,open){
var x=new GlideDateTime(res);
var y=new GlideDateTime(open);
var diff=x.getNumericValue()-y.getNumericValue();
//return diff;
return GlideDuration(diff);
},
    type: 'KAP_SI_3'
};(function executeRule(current, previous /*null when async*/) {
